/* nx01-tui — global stylesheet (see DESIGN.md §12) */

Screen {
    layers: base modals;
    background: $background;
}

/* ── Top / bottom chrome ────────────────────────────────────────── */

AppHeader  { dock: top;    height: 1; background: $surface; }
StatusBar  { dock: bottom; height: 1; background: $surface; }

TabbedContent { height: 1fr; }

/* Solid coloured underline for the active tab (#29 item 26) — replaces
   the default `╸━━━╺` rounded pill which read like a 2D bar chart. */
TabbedContent Tabs > Underline > .underline--bar {
    color: $primary;
    background: $primary;
}

/* ── Shared OptionList chrome (#29 item 5, QA-tightened) ──────────
   The `▊` rail visible on every row was OptionList's own `tall`
   left border — not a focus indicator. Killing the border + tinting
   the highlighted row gives a clean flat list across all modals.   */

OptionList {
    border: none;
    background: $surface;
    padding: 0 1;
}
OptionList:focus {
    border: none;
    background-tint: $foreground 5%;
}
OptionList > .option-list--option-highlighted {
    background: $boost;
    color: $text;
    text-style: bold;
}
OptionList > .option-list--option { padding: 0 1; }

/* ── FlavorPane state-class colors ──────────────────────────────── */
/* (border colors animate automatically via transition rule on FlavorPane) */

FlavorPane           { border: round $panel; }
FlavorPane.thinking  { border: round $warning; }
FlavorPane.streaming { border: round $primary; }
FlavorPane.tool_call { border: round $success; }
FlavorPane.done      { border: round $success 30%; }
FlavorPane.error     { border: round $error; }

/* ── Conversation area ──────────────────────────────────────────── */

ConversationView {
    padding: 1 2;
    height: 1fr;
    background: $background;
}

ChatInput {
    height: auto;
    min-height: 2;
    max-height: 8;
    border: round $panel;
    padding: 0 1;
}
ChatInput:focus { border: round $primary; }

/* SearchBar's DEFAULT_CSS owns dock/height/border — don't override here
   (QA item 2: the previous `height: 1` shadow squashed the round border). */

/* ── Sidebar ────────────────────────────────────────────────────── */

MonitorSidebar {
    width: 30;
    height: 1fr;
    border-left: solid $panel;
    background: $surface;
}
MonitorSidebar.hidden { display: none; }
/* `.icon-strip` removed in QA pass — class is never applied since
   item 3 collapsed the responsive mode to "hide entirely below 130 cols". */

/* ── Modals (overlay layer) ─────────────────────────────────────── */

BaseModal,
CommandModal,
SessionsModal,
MemoryModal,
SkillsModal,
ToolsModal,
ConfigModal,
CostModal,
ModelPickerModal,
HelpModal,
PermissionModal,
ConfirmModal {
    align: center middle;
}

/* ── Misc reusable utility ──────────────────────────────────────── */

.dim       { color: $text-muted; }
.section-title { color: $text-muted; text-style: bold; }
